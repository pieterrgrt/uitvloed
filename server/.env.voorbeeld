# Kopieer naar je server en vul in. Alleen UV_BASIS_URL en SMTP_URL zijn nodig voor productie.

# Het adres van de site zoals bezoekers het zien.
UV_BASIS_URL=https://uitvloed.nl

# Poort waarop de server luistert.
PORT=3000

# Waar de database staat. Bewaar deze map (maak er back-ups van).
UV_DATABASE=/data/uitvloed.db

# SMTP-server voor de inlogmails: smtp://gebruiker:wachtwoord@smtp.voorbeeld.nl:587
# Leeg = de links verschijnen alleen in het logboek (handig om lokaal te testen).
SMTP_URL=

# Afzender van de inlogmail.
UV_AFZENDER=uitvloed <post@uitvloed.nl>

# Zet op 1 als de server achter een proxy staat (Caddy, nginx, Fly.io), zodat het echte IP-adres telt.
UV_ACHTER_PROXY=0
