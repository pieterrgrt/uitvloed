# Kopieer naar .env op de server (cp .env.example .env) en vul in.

# Het adres van de site zoals bezoekers het zien.
UV_BASIS_URL=https://uitvloed.nl

# SMTP-server voor de inlogmails: smtp://gebruiker:wachtwoord@smtp.voorbeeld.nl:587
# Leeg laten tot er een echte mailbox is: de links verschijnen dan in `docker compose logs web`.
# Staat er een @, : of / in het wachtwoord, schrijf dat dan als %40, %3A of %2F.
SMTP_URL=

# Afzender van de inlogmail.
UV_AFZENDER=uitvloed <post@uitvloed.nl>

# Zet op 1 als de server achter een proxy staat (Caddy, nginx, Fly.io), zodat het echte IP-adres telt.
UV_ACHTER_PROXY=1
